+void LogDispatch(const char* kind, uint32_t app_id, uint32_t message, uint32_t buffer_ptr,
+                 uint32_t buffer_length, X_HRESULT result) {
+  struct Seen {
+    X_HRESULT result;
+    uint64_t count;
+  };
+  static std::mutex mutex;
+  static std::unordered_map<uint64_t, Seen> seen;
+  uint64_t key = (uint64_t(app_id) << 32) | message;
+  bool loud;
+  uint64_t count;
+  {
+    std::lock_guard<std::mutex> lock(mutex);
+    auto [it, first] = seen.try_emplace(key, Seen{result, 0});
+    count = ++it->second.count;
+    loud = first || it->second.result != result || count % 1000 == 0;
+    it->second.result = result;
+  }
+  if (loud) {
+    REXSYS_DEBUG("[xmsg] {} app {:08X} msg {:08X} (buf {:08X}, len {}) -> {:08X}{}", kind, app_id,
+                 message, buffer_ptr, buffer_length, result,
+                 count > 1 ? fmt::format(" (call #{})", count) : std::string());
+  } else {
+    REXSYS_TRACE("[xmsg] {} app {:08X} msg {:08X} (buf {:08X}, len {}) -> {:08X}", kind, app_id,
+                 message, buffer_ptr, buffer_length, result);
+  }
+}
