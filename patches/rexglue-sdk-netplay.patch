new file mode 100644
index 0000000..ee58650
--- /dev/null
+++ b/src/system/xsession_discovery.cpp
@@ -0,0 +1,482 @@
+/**
+ * @file        system/xsession_discovery.cpp
+ * @brief       LAN / same-PC session discovery (see xsession_discovery.h)
+ */
+#include <rex/system/xsession_discovery.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <random>
+#include <thread>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/system/xnet_address_table.h>
+
+#if REX_PLATFORM_WIN32
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+REXCVAR_DECLARE(std::string, net_host_ip);
+
+namespace rex::system {
+
+namespace {
+
+constexpr uint8_t kMagic[4] = {'S', 'V', 'R', 'N'};
+constexpr size_t kMaxGamertag = 32;
+constexpr size_t kMaxQosData = 1024;
+constexpr size_t kMaxPacket = 1400;
+
+class Writer {
+ public:
+  void u8(uint8_t v) { bytes_.push_back(v); }
+  void u16(uint16_t v) {
+    u8(uint8_t(v >> 8));
+    u8(uint8_t(v));
+  }
+  void u32(uint32_t v) {
+    u16(uint16_t(v >> 16));
+    u16(uint16_t(v));
+  }
+  void raw(const uint8_t* p, size_t n) { bytes_.insert(bytes_.end(), p, p + n); }
+  std::vector<uint8_t> take() { return std::move(bytes_); }
+
+ private:
+  std::vector<uint8_t> bytes_;
+};
+
+class Reader {
+ public:
+  Reader(const uint8_t* p, size_t n) : p_(p), n_(n) {}
+  bool ok() const { return ok_; }
+  bool done() const { return ok_ && pos_ == n_; }
+  uint8_t u8() { return need(1) ? p_[pos_++] : 0; }
+  uint16_t u16() {
+    uint16_t hi = u8();
+    return uint16_t(hi << 8 | u8());
+  }
+  uint32_t u32() {
+    uint32_t hi = u16();
+    return hi << 16 | u16();
+  }
+  void raw(uint8_t* out, size_t n) {
+    if (need(n)) {
+      std::memcpy(out, p_ + pos_, n);
+      pos_ += n;
+    }
+  }
+
+ private:
+  bool need(size_t k) {
+    if (!ok_ || n_ - pos_ < k) {
+      ok_ = false;
+      return false;
+    }
+    return true;
+  }
+  const uint8_t* p_;
+  size_t n_;
+  size_t pos_ = 0;
+  bool ok_ = true;
+};
+
+void WriteHeader(Writer& w, DiscoveryPacket type, uint32_t title_id, uint32_t nonce) {
+  w.raw(kMagic, 4);
+  w.u8(kDiscoveryVersion);
+  w.u8(uint8_t(type));
+  w.u16(0);
+  w.u32(title_id);
+  w.u32(nonce);
+}
+
+// Returns the nonce if the header is ours, of `type`, for `title_id`.
+std::optional<uint32_t> ReadHeader(Reader& r, DiscoveryPacket type, uint32_t title_id) {
+  uint8_t magic[4];
+  r.raw(magic, 4);
+  uint8_t version = r.u8();
+  uint8_t kind = r.u8();
+  r.u16();
+  uint32_t title = r.u32();
+  uint32_t nonce = r.u32();
+  if (!r.ok() || std::memcmp(magic, kMagic, 4) != 0 || version != kDiscoveryVersion ||
+      kind != uint8_t(type) || title != title_id) {
+    return std::nullopt;
+  }
+  return nonce;
+}
+
+uint64_t NowMs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+
+uint32_t RandomNonce() {
+  static std::mt19937 rng{std::random_device{}()};
+  uint32_t n;
+  do {
+    n = rng();
+  } while (n == 0);
+  return n;
+}
+
+#if REX_PLATFORM_WIN32
+using socket_t = SOCKET;
+constexpr socket_t kNoSocket = INVALID_SOCKET;
+#else
+using socket_t = int;
+constexpr socket_t kNoSocket = -1;
+#endif
+
+void SendTo(intptr_t sock, const std::vector<uint8_t>& packet, uint32_t ip, uint16_t port) {
+  sockaddr_in to = {};
+  to.sin_family = AF_INET;
+  to.sin_addr.s_addr = htonl(ip);
+  to.sin_port = htons(port);
+  sendto(socket_t(sock), reinterpret_cast<const char*>(packet.data()), int(packet.size()), 0,
+         reinterpret_cast<sockaddr*>(&to), sizeof(to));
+}
+
+}  // namespace
+
+uint64_t SessionAdvert::session_id() const {
+  uint64_t id = 0;
+  for (int i = 0; i < 8; ++i) {
+    id = id << 8 | session_info[i];
+  }
+  return id;
+}
+
+std::vector<uint8_t> EncodeQuery(uint32_t title_id, uint32_t nonce) {
+  Writer w;
+  WriteHeader(w, DiscoveryPacket::kQuery, title_id, nonce);
+  return w.take();
+}
+
+std::optional<uint32_t> DecodeQuery(const uint8_t* data, size_t size, uint32_t title_id) {
+  Reader r(data, size);
+  auto nonce = ReadHeader(r, DiscoveryPacket::kQuery, title_id);
+  return nonce && r.done() ? nonce : std::nullopt;
+}
+
+std::vector<uint8_t> EncodeAdvert(const SessionAdvert& a, uint32_t nonce) {
+  Writer w;
+  WriteHeader(w, DiscoveryPacket::kAdvert, a.title_id, nonce);
+  w.raw(a.session_info.data(), a.session_info.size());
+  w.u32(a.open_public);
+  w.u32(a.open_private);
+  w.u32(a.filled_public);
+  w.u32(a.filled_private);
+  const size_t tag = std::min(a.host_gamertag.size(), kMaxGamertag);
+  w.u8(uint8_t(tag));
+  w.raw(reinterpret_cast<const uint8_t*>(a.host_gamertag.data()), tag);
+  const size_t contexts = std::min<size_t>(a.contexts.size(), 255);
+  w.u8(uint8_t(contexts));
+  for (size_t i = 0; i < contexts; ++i) {
+    w.u32(a.contexts[i].id);
+    w.u32(a.contexts[i].value);
+  }
+  const size_t properties = std::min<size_t>(a.properties.size(), 255);
+  w.u8(uint8_t(properties));
+  for (size_t i = 0; i < properties; ++i) {
+    w.u32(a.properties[i].id);
+    w.u8(a.properties[i].type);
+    w.raw(a.properties[i].value.data(), 8);
+  }
+  const size_t qos = std::min(a.qos_data.size(), kMaxQosData);
+  w.u16(uint16_t(qos));
+  w.raw(a.qos_data.data(), qos);
+  return w.take();
+}
+
+std::optional<SessionAdvert> DecodeAdvert(const uint8_t* data, size_t size, uint32_t title_id,
+                                          uint32_t* nonce_out) {
+  Reader r(data, size);
+  auto nonce = ReadHeader(r, DiscoveryPacket::kAdvert, title_id);
+  if (!nonce) {
+    return std::nullopt;
+  }
+  SessionAdvert a;
+  a.title_id = title_id;
+  r.raw(a.session_info.data(), a.session_info.size());
+  a.open_public = r.u32();
+  a.open_private = r.u32();
+  a.filled_public = r.u32();
+  a.filled_private = r.u32();
+  const uint8_t tag = r.u8();
+  if (tag > kMaxGamertag) {
+    return std::nullopt;
+  }
+  a.host_gamertag.resize(tag);
+  r.raw(reinterpret_cast<uint8_t*>(a.host_gamertag.data()), tag);
+  a.contexts.resize(r.u8());
+  for (auto& c : a.contexts) {
+    c.id = r.u32();
+    c.value = r.u32();
+  }
+  a.properties.resize(r.u8());
+  for (auto& p : a.properties) {
+    p.id = r.u32();
+    p.type = r.u8();
+    r.raw(p.value.data(), 8);
+  }
+  const uint16_t qos = r.u16();
+  if (qos > kMaxQosData) {
+    return std::nullopt;
+  }
+  a.qos_data.resize(qos);
+  r.raw(a.qos_data.data(), qos);
+  if (!r.done()) {
+    return std::nullopt;
+  }
+  if (nonce_out) {
+    *nonce_out = *nonce;
+  }
+  return a;
+}
+
+SessionDiscovery& SessionDiscovery::Get() {
+  static SessionDiscovery instance;
+  return instance;
+}
+
+bool SessionDiscovery::Start(uint32_t title_id, int32_t port_offset) {
+  std::lock_guard lock(mutex_);
+  if (started_) {
+    return socket_ != -1;
+  }
+  started_ = true;
+  title_id_ = title_id;
+  port_offset_ = port_offset;
+#if REX_PLATFORM_WIN32
+  WSADATA wsa_data;
+  WSAStartup(MAKEWORD(2, 2), &wsa_data);
+#endif
+  socket_t sock = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (sock == kNoSocket) {
+    REXSYS_ERROR("[net] discovery: can't create a UDP socket");
+    return false;
+  }
+  int on = 1;
+  setsockopt(sock, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&on), sizeof(on));
+  const uint16_t port = uint16_t(kDiscoveryBasePort + port_offset);
+  sockaddr_in local = {};
+  local.sin_family = AF_INET;
+  local.sin_addr.s_addr = htonl(INADDR_ANY);
+  local.sin_port = htons(port);
+  if (bind(sock, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+    REXSYS_ERROR(
+        "[net] discovery: can't bind UDP port {} (another instance with the same "
+        "net_port?); this instance can search but not be found",
+        port);
+  } else {
+    REXSYS_INFO("[net] discovery: listening on UDP port {} (title {:08X})", port, title_id);
+  }
+  socket_ = intptr_t(sock);
+  std::thread([this] { ReceiveLoop(); }).detach();
+  return true;
+}
+
+void SessionDiscovery::SetHosted(std::optional<SessionAdvert> advert) {
+  std::lock_guard lock(mutex_);
+  if (advert) {
+    for (const auto& [id, data] : qos_data_) {
+      if (id == advert->session_id()) {
+        advert->qos_data = data;
+      }
+    }
+    REXSYS_INFO(
+        "[net] discovery: now advertising session {:016X} ({} open public, {} open "
+        "private slots, {} contexts, {} properties, {} QoS bytes)",
+        advert->session_id(), advert->open_public, advert->open_private, advert->contexts.size(),
+        advert->properties.size(), advert->qos_data.size());
+  } else if (hosted_) {
+    REXSYS_INFO("[net] discovery: stopped advertising session {:016X}", hosted_->session_id());
+  }
+  hosted_ = std::move(advert);
+}
+
+void SessionDiscovery::SetQosData(uint64_t session_id, std::vector<uint8_t> data) {
+  std::lock_guard lock(mutex_);
+  if (hosted_ && hosted_->session_id() == session_id) {
+    hosted_->qos_data = data;
+  }
+  for (auto& [id, d] : qos_data_) {
+    if (id == session_id) {
+      d = std::move(data);
+      return;
+    }
+  }
+  qos_data_.emplace_back(session_id, std::move(data));
+}
+
+std::optional<SessionAdvert> SessionDiscovery::hosted() const {
+  std::lock_guard lock(mutex_);
+  return hosted_;
+}
+
+void SessionDiscovery::ReceiveLoop() {
+  std::vector<uint8_t> buffer(kMaxPacket);
+  while (true) {
+    sockaddr_in from = {};
+    socklen_t from_len = sizeof(from);
+    const int n =
+        int(recvfrom(socket_t(socket_), reinterpret_cast<char*>(buffer.data()), int(buffer.size()),
+                     0, reinterpret_cast<sockaddr*>(&from), &from_len));
+    if (n <= 0) {
+#if REX_PLATFORM_WIN32
+      // A query to a port nobody listens on comes back as WSAECONNRESET on
+      // Windows; that's normal for a search, not a dead socket.
+      if (WSAGetLastError() == WSAECONNRESET) {
+        continue;
+      }
+#endif
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+      continue;
+    }
+    const uint32_t from_ip = ntohl(from.sin_addr.s_addr);
+    const uint16_t from_port = ntohs(from.sin_port);
+    std::lock_guard lock(mutex_);
+    if (auto nonce = DecodeQuery(buffer.data(), size_t(n), title_id_)) {
+      if (hosted_) {
+        SendTo(socket_, EncodeAdvert(*hosted_, *nonce), from_ip, from_port);
+        REXSYS_DEBUG("[net] discovery: answered query {:08X} from {}:{}", *nonce,
+                     FormatIPv4(from_ip), from_port);
+      }
+      continue;
+    }
+    uint32_t nonce = 0;
+    if (auto advert = DecodeAdvert(buffer.data(), size_t(n), title_id_, &nonce)) {
+      if (nonce != pending_nonce_ || pending_nonce_ == 0) {
+        continue;  // a late answer to an earlier search
+      }
+      const uint64_t id = advert->session_id();
+      bool dup = std::any_of(pending_.begin(), pending_.end(),
+                             [&](const FoundSession& f) { return f.advert.session_id() == id; });
+      if (!dup) {
+        pending_.push_back(
+            {std::move(*advert), from_ip, from_port, uint32_t(NowMs() - pending_sent_ms_)});
+      }
+      continue;
+    }
+    REXSYS_DEBUG(
+        "[net] discovery: ignored {} bytes from {}:{} (not ours, other version or "
+        "other title)",
+        n, FormatIPv4(from_ip), from_port);
+  }
+}
+
+std::vector<FoundSession> SessionDiscovery::Collect(
+    const std::vector<std::pair<uint32_t, uint16_t>>& targets, uint32_t timeout_ms,
+    std::optional<uint64_t> want) {
+  uint32_t nonce = RandomNonce();
+  std::optional<uint64_t> own;
+  {
+    std::lock_guard lock(mutex_);
+    if (socket_ == -1) {
+      return {};
+    }
+    pending_nonce_ = nonce;
+    pending_sent_ms_ = NowMs();
+    pending_.clear();
+    if (hosted_) {
+      own = hosted_->session_id();
+    }
+  }
+  const auto query = EncodeQuery(title_id_, nonce);
+  for (const auto& [ip, port] : targets) {
+    SendTo(socket_, query, ip, port);
+  }
+  const uint64_t deadline = NowMs() + timeout_ms;
+  std::vector<FoundSession> found;
+  while (NowMs() < deadline) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    std::lock_guard lock(mutex_);
+    if (want && std::any_of(pending_.begin(), pending_.end(), [&](const FoundSession& f) {
+          return f.advert.session_id() == *want;
+        })) {
+      break;
+    }
+  }
+  std::lock_guard lock(mutex_);
+  for (auto& f : pending_) {
+    if (own && f.advert.session_id() == *own) {
+      continue;
+    }
+    if (want && f.advert.session_id() != *want) {
+      continue;
+    }
+    seen_.erase(std::remove_if(seen_.begin(), seen_.end(),
+                               [&](const FoundSession& s) {
+                                 return s.advert.session_id() == f.advert.session_id();
+                               }),
+                seen_.end());
+    seen_.push_back(f);
+    found.push_back(f);
+  }
+  pending_nonce_ = 0;
+  pending_.clear();
+  return found;
+}
+
+std::vector<FoundSession> SessionDiscovery::Search(uint32_t timeout_ms) {
+  std::vector<std::pair<uint32_t, uint16_t>> targets;
+  std::vector<uint32_t> ips = {INADDR_BROADCAST, INADDR_LOOPBACK};
+  const std::string host = REXCVAR_GET(net_host_ip);
+  if (!host.empty()) {
+    in_addr addr = {};
+    if (inet_pton(AF_INET, host.c_str(), &addr) == 1) {
+      ips.push_back(ntohl(addr.s_addr));
+    } else {
+      REXSYS_WARN("[net] discovery: net_host_ip '{}' is not an IPv4 address", host);
+    }
+  }
+  for (uint32_t ip : ips) {
+    for (int32_t i = 0; i < kDiscoveryPorts; ++i) {
+      targets.emplace_back(ip, uint16_t(kDiscoveryBasePort + i));
+    }
+  }
+  auto found = Collect(targets, timeout_ms, std::nullopt);
+  REXSYS_INFO("[net] discovery: search found {} session(s){}", found.size(),
+              host.empty() ? "" : fmt::format(" (also asked {})", host));
+  for (const auto& f : found) {
+    REXSYS_INFO(
+        "[net] discovery:   {:016X} hosted by '{}' at {}:{}, {} ms, {}/{} public slots open",
+        f.advert.session_id(), f.advert.host_gamertag, FormatIPv4(f.from_ip), f.from_port, f.rtt_ms,
+        f.advert.open_public, f.advert.open_public + f.advert.filled_public);
+  }
+  return found;
+}
+
+std::optional<FoundSession> SessionDiscovery::Find(uint64_t session_id) const {
+  std::lock_guard lock(mutex_);
+  for (const auto& f : seen_) {
+    if (f.advert.session_id() == session_id) {
+      return f;
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<FoundSession> SessionDiscovery::Probe(uint32_t ip, int32_t port_offset,
+                                                    uint64_t session_id, uint32_t timeout_ms) {
+  auto found = Collect({{ip, uint16_t(kDiscoveryBasePort + port_offset)}}, timeout_ms, session_id);
+  if (found.empty()) {
+    return std::nullopt;
+  }
+  return found.front();
+}
+
+}  // namespace rex::system
