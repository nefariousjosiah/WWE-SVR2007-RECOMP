+      "[net] XNetQosListen(session {:016X}, flags {:02X}) -> {} , {} data bytes {:02X}, "
+      "{} bps",
+      key, uint32_t(flags), listener.enabled ? "enabled" : "disabled", listener.data.size(),
+      fmt::join(listener.data, ""), listener.bits_per_sec);
+  return 0;
+}
+
+constexpr uint8_t XNET_XNQOSINFO_COMPLETE = 0x01;
+constexpr uint8_t XNET_XNQOSINFO_TARGET_CONTACTED = 0x02;
+constexpr uint8_t XNET_XNQOSINFO_DATA_RECEIVED = 0x08;
+
+// Probes hosts before joining: is the host there, how far, and its listen
+// data (lobby settings). Answered from session discovery: the advert seen by
+// the last search, or a direct query to the host. Completes before returning.
+u32 NetDll_XNetQosLookup_entry(u32 caller, u32 xnaddr_count, u32 xnaddrs_ptr, u32 xnkids_ptr,
+                               u32 xnkeys_ptr, u32 ina_count, u32 inas_ptr, u32 service_ids_ptr,
+                               u32 probes, u32 bits_per_sec, u32 flags, u32 event_handle,
+                               mapped_u32 pqos) {
+  auto* mem = REX_KERNEL_MEMORY();
+  auto& discovery = SessionDiscovery::Get();
+  discovery.Start(REX_KERNEL_STATE()->title_id(), xnet_table().local_port_offset());
+
+  struct Answer {
+    std::optional<FoundSession> found;
+  };
+  std::vector<Answer> answers(xnaddr_count);
+  size_t data_bytes = 0;
+  for (uint32_t i = 0; i < xnaddr_count; ++i) {
+    uint32_t xnaddr_va = xnaddrs_ptr ? memory::load_and_swap<uint32_t>(
+                                           mem->TranslateVirtual(xnaddrs_ptr + i * 4))
+                                     : 0;
+    uint32_t xnkid_va = xnkids_ptr ? memory::load_and_swap<uint32_t>(
+                                         mem->TranslateVirtual(xnkids_ptr + i * 4))
+                                   : 0;
+    if (!xnaddr_va || !xnkid_va) {
+      continue;
+    }
+    auto* xnaddr = mem->TranslateVirtual<XNADDR*>(xnaddr_va);
+    auto* kid = mem->TranslateVirtual<uint8_t*>(xnkid_va);
+    uint64_t session_id = 0;
+    for (int b = 0; b < 8; ++b) {
+      session_id = session_id << 8 | kid[b];
+    }
+    uint32_t ip = LoadInAddr(xnaddr->inaOnline);
+    int32_t offset = XNetAddressTable::OffsetFromAdvertisedPort(xnaddr->wPortOnline);
+    auto found = discovery.Find(session_id);
+    if (!found) {
+      found = discovery.Probe(ip, offset, session_id, 500);
+    }
+    REXKRNL_INFO("[net] XNetQosLookup #{}: session {:016X} at {}:{} -> {}", i, session_id,
+                 FormatIPv4(ip), XNetAddressTable::AdvertisedPort(offset),
+                 found ? fmt::format("contacted, {} ms, {} data bytes", found->rtt_ms,
+                                     found->advert.qos_data.size())
+                       : std::string("no answer"));
+    if (found) {
+      data_bytes += found->advert.qos_data.size();
+    }
+    answers[i].found = std::move(found);
+  }
+  if (ina_count) {
+    REXKRNL_WARN("[net] XNetQosLookup: {} service (IN_ADDR) probes not supported", ina_count);
+  }
+
+  const uint32_t count = std::max<uint32_t>(xnaddr_count, 1);
+  const uint32_t header = uint32_t(offsetof(XNQOS, info) + sizeof(XNQOSINFO) * count);
+  const uint32_t qos_va = mem->SystemHeapAlloc(uint32_t(header + data_bytes));
+  auto* qos = mem->TranslateVirtual<XNQOS*>(qos_va);
+  std::memset(qos, 0, header + data_bytes);
+  qos->count = xnaddr_count;
+  qos->count_pending = 0;
+  uint32_t data_va = qos_va + header;
+  for (uint32_t i = 0; i < xnaddr_count; ++i) {
+    auto& info = qos->info[i];
+    info.flags = XNET_XNQOSINFO_COMPLETE;
+    if (!answers[i].found) {
+      continue;
+    }
+    const auto& f = *answers[i].found;
+    const uint16_t rtt = uint16_t(std::clamp<uint32_t>(f.rtt_ms, 1, 0xFFFF));
+    info.flags |= XNET_XNQOSINFO_TARGET_CONTACTED;
+    info.probes_xmit = uint16_t(std::max<uint32_t>(probes, 1));
+    info.probes_recv = uint16_t(std::max<uint32_t>(probes, 1));
+    info.rtt_min_in_msecs = rtt;
+    info.rtt_med_in_msecs = rtt;
+    // No bandwidth measurement; report a healthy broadband link.
+    info.up_bits_per_sec = 10'000'000;
+    info.down_bits_per_sec = 10'000'000;
+    if (!f.advert.qos_data.empty()) {
+      info.flags |= XNET_XNQOSINFO_DATA_RECEIVED;
+      info.data_len = uint16_t(f.advert.qos_data.size());
+      info.data_ptr = data_va;
+      std::memcpy(mem->TranslateVirtual(data_va), f.advert.qos_data.data(),
+                  f.advert.qos_data.size());
+      data_va += uint32_t(f.advert.qos_data.size());
+    }
+  }
+  if (pqos) {
+    *pqos = qos_va;
+  }
+  if (event_handle) {
+    if (auto ev = REX_KERNEL_OBJECTS()->LookupObject<XEvent>(event_handle)) {
+      ev->Set(0, false);
+    }
+  }
+  REXKRNL_DEBUG("[net] XNetQosLookup({} hosts, {} probes, flags {:08X}) -> XNQOS {:08X}",
+                uint32_t(xnaddr_count), uint32_t(probes), uint32_t(flags), qos_va);
+  return 0;
 }
 
