+bool EnsureNetIdentity() {
+  bool generated = false;
+  if (!REXCVAR_GET(net_xuid)) {
+    std::random_device rd;
+    uint64_t r = (uint64_t(rd()) << 32) | rd();
+    REXCVAR_SET(net_xuid, kOnlineXuidPrefix | (r & kOnlineXuidRandomMask));
+    generated = true;
+  }
+  if (REXCVAR_GET(net_gamertag).empty()) {
