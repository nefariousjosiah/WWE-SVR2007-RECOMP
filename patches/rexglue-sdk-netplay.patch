+namespace {
+// Online XUIDs on retail consoles start with 0x0009. Keep it that way: some
+// titles reject XUIDs with bits outside the usual ranges (e.g. 58410A1F checks
+// 0x00C0000000000000 and refuses to run if any are set).
+constexpr uint64_t kOnlineXuidPrefix = 0x0009000000000000ull;
+constexpr uint64_t kOnlineXuidRandomMask = 0x0000FFFFFFFFFFFFull;
+constexpr size_t kMaxGamertagLength = 15;
