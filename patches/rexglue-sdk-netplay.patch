diff --git a/include/rex/system/xnet_address_table.h b/include/rex/system/xnet_address_table.h
new file mode 100644
index 0000000..c850eb8
--- /dev/null
+++ b/include/rex/system/xnet_address_table.h
@@ -0,0 +1,119 @@
+/**
+ * @file        system/xnet_address_table.h
+ * @brief       Maps XNet peers to opaque guest IN_ADDRs and real UDP endpoints
+ *
+ * On a real console XNetXnAddrToInAddr returns an opaque IN_ADDR that only the
+ * XNet stack can route. We do the same: every peer XNADDR gets a virtual
+ * address in 10.64.0.0/16, and the socket layer translates it to the peer's
+ * real IPv4 endpoint on the way out (and back on the way in).
+ *
+ * Several instances can share one host by running with different net_port
+ * values. Each instance shifts every guest-bound UDP port by
+ * (net_port - kXNetBasePort), and advertises net_port in its XNADDR so peers
+ * know which shift to apply when sending to it.
+ *
+ * All addresses and ports here are in host byte order.
+ */
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace rex::system {
+
+// The XNADDR online port an instance advertises when net_port is unchanged.
+constexpr uint16_t kXNetBasePort = 3074;
+
+// "a.b.c.d" for a host-order IPv4 address, for logs.
+inline std::string FormatIPv4(uint32_t ip) {
+  return std::to_string((ip >> 24) & 0xFF) + "." + std::to_string((ip >> 16) & 0xFF) + "." +
+         std::to_string((ip >> 8) & 0xFF) + "." + std::to_string(ip & 0xFF);
+}
+
+struct XNetPeer {
+  uint32_t ip = 0;
+  int32_t port_offset = 0;
+
+  bool operator==(const XNetPeer&) const = default;
+};
+
+struct XNetEndpoint {
+  uint32_t ip = 0;
+  uint16_t port = 0;
+
+  bool operator==(const XNetEndpoint&) const = default;
+};
+
+class XNetAddressTable {
+ public:
+  // A private range, so titles that sanity-check addresses (or round-trip
+  // them through XNetInAddrToString and inet_addr) accept them. A real LAN
+  // in 10.64.0.0/16 would collide; LocalIPv4 warns about that.
+  static constexpr uint32_t kVirtualPrefix = 0x0A400000;
+  static constexpr uint32_t kVirtualMask = 0xFFFF0000;
+  static constexpr uint32_t kMaxPeers = 0xFFFE;
+
+  static bool IsVirtual(uint32_t ip) { return (ip & kVirtualMask) == kVirtualPrefix; }
+
+  static uint16_t AdvertisedPort(int32_t port_offset) {
+    return static_cast<uint16_t>(kXNetBasePort + port_offset);
+  }
+  static int32_t OffsetFromAdvertisedPort(uint16_t port) {
+    // Old or zeroed XNADDRs carry no port; treat them as unshifted.
+    return port ? int32_t(port) - kXNetBasePort : 0;
+  }
+
+  void SetLocalPortOffset(int32_t offset);
+  int32_t local_port_offset() const;
+
+  // This console's own address (host order), as advertised to peers. A peer at that address is
+  // another instance on this PC; Windows doesn't deliver unicast to the PC's own LAN address, so
+  // those packets go over loopback instead (ToWire) and loopback senders map back (FromWire).
+  static constexpr uint32_t kLoopback = 0x7F000001;
+  void SetLocalIp(uint32_t ip);
+  uint32_t local_ip() const;
+
+  // Returns the virtual address for this peer, allocating one if needed.
+  // Returns 0 if the table is full.
+  uint32_t Register(const XNetPeer& peer);
+  std::optional<XNetPeer> Lookup(uint32_t virtual_ip) const;
+  std::optional<uint32_t> Find(const XNetPeer& peer) const;
+  bool Unregister(uint32_t virtual_ip);
+  void Clear();
+
+  // Port to hand the host OS for a guest bind(). Port 0 (ephemeral) stays 0.
+  uint16_t HostBindPort(uint16_t guest_port) const;
+
+  // Guest destination -> wire destination. Non-virtual addresses pass through.
+  XNetEndpoint ToWire(XNetEndpoint guest) const;
+
+  // Wire source -> source the guest should see. `local_guest_port` is the
+  // guest port of the receiving socket; it disambiguates several peers that
+  // share one IP (instances on the same host) since titles typically use the
+  // same game port on every peer. Unknown sources pass through.
+  //
+  // A source we have no entry for is given one, as XNet does for a peer that connects to us: a
+  // host learns of a joiner from its first packet, and the title then asks for its XNADDR
+  // (XNetInAddrToXnAddr). The peer's port offset follows from its source port, since titles use
+  // the same game port everywhere. Packets that don't fit (a DNS reply, say) pass through, and
+  // a packet that looks like our own address and offset is never matched to ourselves.
+  XNetEndpoint FromWire(XNetEndpoint wire, uint16_t local_guest_port);
+
+ private:
+  static uint16_t ShiftPort(uint16_t port, int32_t offset);
+  // Register with mutex_ held.
+  uint32_t RegisterLocked(const XNetPeer& peer);
+  // Peers with offsets from 0 up to this are taken as instances of the title on that host.
+  static constexpr int32_t kMaxAutoOffset = 15;
+
+  mutable std::mutex mutex_;
+  int32_t local_port_offset_ = 0;
+  uint32_t local_ip_ = 0;
+  // Index i holds the peer for virtual address kVirtualPrefix | (i + 1).
+  std::vector<std::optional<XNetPeer>> peers_;
+};
+
+}  // namespace rex::system
diff --git a/include/rex/system/xsession_discovery.h b/include/rex/system/xsession_discovery.h
new file mode 100644
index 0000000..5c169b4
--- /dev/null
+++ b/include/rex/system/xsession_discovery.h
@@ -0,0 +1,129 @@
+/**
+ * @file        system/xsession_discovery.h
+ * @brief       Finding hosted sessions without Xbox LIVE: LAN / same-PC discovery
+ *
+ * A host answers queries on UDP kDiscoveryBasePort + its port offset (3070 for
+ * the first instance on a PC, 3071 for the second, ...). A search sends a query
+ * to the broadcast address, to 127.0.0.1 and to net_host_ip, on every
+ * instance's port, and collects the hosts' adverts. The advert carries what
+ * XSessionSearch and XNetQosLookup hand the title: the session's XSESSION_INFO,
+ * slot counts, the host's contexts and properties, and its QoS listen data.
+ */
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace rex::system {
+
+constexpr uint16_t kDiscoveryBasePort = 3070;
+// Instances per PC a search reaches (port offsets 0 .. kDiscoveryPorts - 1).
+constexpr int32_t kDiscoveryPorts = 4;
+// Bumped when the wire format changes; peers ignore other versions.
+constexpr uint8_t kDiscoveryVersion = 1;
+
+// XUSER_PROPERTY value as the guest stores it: the XUSER_DATA type byte and
+// its 8-byte payload, still big-endian. Only fixed-size types travel
+// (CONTEXT, INT32, INT64, DOUBLE, FLOAT, DATETIME).
+struct SessionProperty {
+  uint32_t id = 0;
+  uint8_t type = 0;
+  std::array<uint8_t, 8> value{};
+
+  bool operator==(const SessionProperty&) const = default;
+};
+
+struct SessionContext {
+  uint32_t id = 0;
+  uint32_t value = 0;
+
+  bool operator==(const SessionContext&) const = default;
+};
+
+struct SessionAdvert {
+  uint32_t title_id = 0;
+  // XSESSION_INFO: XNKID, the host's XNADDR, XNKEY (guest layout).
+  std::array<uint8_t, 60> session_info{};
+  uint32_t open_public = 0;
+  uint32_t open_private = 0;
+  uint32_t filled_public = 0;
+  uint32_t filled_private = 0;
+  std::string host_gamertag;
+  std::vector<SessionContext> contexts;
+  std::vector<SessionProperty> properties;
+  std::vector<uint8_t> qos_data;  // XNetQosListen data, for XNetQosLookup
+
+  uint64_t session_id() const;  // the XNKID as a number, for logs and lookups
+
+  bool operator==(const SessionAdvert&) const = default;
+};
+
+enum class DiscoveryPacket : uint8_t { kQuery = 1, kAdvert = 2 };
+
+// Wire format. Encode* never fail; Decode* return nullopt for anything that
+// isn't a well-formed packet of this version for this title.
+std::vector<uint8_t> EncodeQuery(uint32_t title_id, uint32_t nonce);
+std::optional<uint32_t> DecodeQuery(const uint8_t* data, size_t size, uint32_t title_id);
+std::vector<uint8_t> EncodeAdvert(const SessionAdvert& advert, uint32_t nonce);
+std::optional<SessionAdvert> DecodeAdvert(const uint8_t* data, size_t size, uint32_t title_id,
+                                          uint32_t* nonce_out = nullptr);
+
+struct FoundSession {
+  SessionAdvert advert;
+  uint32_t from_ip = 0;  // host order
+  uint16_t from_port = 0;
+  uint32_t rtt_ms = 0;
+};
+
+// The discovery socket and its answering thread; one per process.
+class SessionDiscovery {
+ public:
+  static SessionDiscovery& Get();
+
+  // Binds kDiscoveryBasePort + port_offset. Safe to call again (no-op).
+  bool Start(uint32_t title_id, int32_t port_offset);
+
+  // The session this instance hosts, answered to queries; nullopt stops.
+  void SetHosted(std::optional<SessionAdvert> advert);
+  std::optional<SessionAdvert> hosted() const;
+
+  // XNetQosListen's data for a session, sent with its advert (the title may
+  // set it before or after creating the session).
+  void SetQosData(uint64_t session_id, std::vector<uint8_t> data);
+
+  // Queries every target and waits up to timeout_ms for adverts. Our own
+  // hosted session is left out. Results are also kept for Find().
+  std::vector<FoundSession> Search(uint32_t timeout_ms);
+
+  // A session seen by the last searches, by XNKID.
+  std::optional<FoundSession> Find(uint64_t session_id) const;
+
+  // Asks one host directly (XNetQosLookup for a session not searched for).
+  std::optional<FoundSession> Probe(uint32_t ip, int32_t port_offset, uint64_t session_id,
+                                    uint32_t timeout_ms);
+
+ private:
+  SessionDiscovery() = default;
+  void ReceiveLoop();
+  std::vector<FoundSession> Collect(const std::vector<std::pair<uint32_t, uint16_t>>& targets,
+                                    uint32_t timeout_ms, std::optional<uint64_t> want);
+
+  mutable std::mutex mutex_;
+  bool started_ = false;
+  uint32_t title_id_ = 0;
+  int32_t port_offset_ = 0;
+  intptr_t socket_ = -1;
+  std::optional<SessionAdvert> hosted_;
+  std::vector<std::pair<uint64_t, std::vector<uint8_t>>> qos_data_;
+  // Replies to the query in flight (nonce), gathered by ReceiveLoop.
+  uint32_t pending_nonce_ = 0;
+  uint64_t pending_sent_ms_ = 0;
+  std::vector<FoundSession> pending_;
+  std::vector<FoundSession> seen_;
+};
+
+}  // namespace rex::system
diff --git a/src/kernel/xam/apps/xgi_app.cpp b/src/kernel/xam/apps/xgi_app.cpp
index 2b222da..95c0590 100644
--- a/src/kernel/xam/apps/xgi_app.cpp
+++ b/src/kernel/xam/apps/xgi_app.cpp
@@ -9,10 +9,24 @@
  * @modified    Tom Clay, 2026 - Adapted for ReXGlue runtime
  */
 
+#include <algorithm>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include <fmt/format.h>
+
 #include <rex/kernel/xam/apps/xgi_app.h>
+#include <rex/cvar.h>
+#include <rex/kernel/xam/xnet.h>
 #include <rex/logging.h>
+#include <rex/system/xnet_address_table.h>
+#include <rex/system/xsession_discovery.h>
 #include <rex/thread.h>
 
+REXCVAR_DECLARE(std::string, net_gamertag);
+
 namespace rex {
 namespace kernel {
 namespace xam {
@@ -23,6 +37,285 @@ using namespace rex::system;
 
 XgiApp::XgiApp(KernelState* kernel_state) : App(kernel_state, 0xFB) {}
 
+namespace {
+
+// XSESSION_CREATE_* flags.
+constexpr uint32_t kSessionCreateHost = 0x00000001;
+
+constexpr X_HRESULT kInsufficientBuffer = 0x0000007A;  // ERROR_INSUFFICIENT_BUFFER
+
+std::string Hex(const uint8_t* data, size_t size) {
+  std::string out;
+  for (size_t i = 0; i < size; ++i) {
+    out += fmt::format("{:02X}", data[i]);
+  }
+  return out;
+}
+
+// How long XSessionSearch waits for hosts to answer.
+constexpr uint32_t kSearchTimeoutMs = 800;
+
+// Guest layouts (big-endian).
+constexpr uint32_t kSearchResultSize = 92;     // XSESSION_SEARCHRESULT
+constexpr uint32_t kUserContextSize = 8;       // XUSER_CONTEXT { id, value }
+constexpr uint32_t kUserPropertySize = 24;     // XUSER_PROPERTY { id, pad, XUSER_DATA }
+constexpr uint32_t kUserDataValueOffset = 16;  // XUSER_DATA's union, from the property start
+
+// XPROPERTYTYPEFROMID: the XUSER_DATA type is in the id's top nibble.
+uint8_t PropertyType(uint32_t id) {
+  return uint8_t((id >> 28) & 0xF);
+}
+bool IsFixedSizeType(uint8_t type) {
+  // CONTEXT, INT32, INT64, DOUBLE, FLOAT, DATETIME (UNICODE and BINARY point elsewhere).
+  return type == 0 || type == 1 || type == 2 || type == 3 || type == 5 || type == 7;
+}
+
+// What the signed-in user told XGI (XUserSetContext / XUserSetProperty). A
+// hosted session advertises these; titles key match types and lobby settings
+// on them.
+std::mutex g_user_mutex;
+std::vector<SessionContext> g_user_contexts;
+std::vector<SessionProperty> g_user_properties;
+
+// The session this instance hosts (XSessionCreate with the host flag).
+uint32_t g_hosted_session_ptr = 0;
+
+void StartDiscovery(KernelState* kernel_state) {
+  SessionDiscovery::Get().Start(kernel_state->title_id(), LocalPortOffset());
+}
+
+void Advertise(uint32_t session_ptr, const uint8_t* session_info, uint32_t public_slots,
+               uint32_t private_slots, KernelState* kernel_state) {
+  SessionAdvert advert;
+  advert.title_id = kernel_state->title_id();
+  std::memcpy(advert.session_info.data(), session_info, kSessionInfoSize);
+  advert.open_public = public_slots;
+  advert.open_private = private_slots;
+  advert.host_gamertag = REXCVAR_GET(net_gamertag);
+  {
+    std::lock_guard lock(g_user_mutex);
+    advert.contexts = g_user_contexts;
+    advert.properties = g_user_properties;
+  }
+  StartDiscovery(kernel_state);
+  g_hosted_session_ptr = session_ptr;
+  SessionDiscovery::Get().SetHosted(std::move(advert));
+}
+
+// A player joined (+1) or left (-1) the session we host.
+void AdjustHostedSlots(uint32_t session_ptr, int delta, bool private_slot) {
+  if (!session_ptr || session_ptr != g_hosted_session_ptr) {
+    return;
+  }
+  auto& discovery = SessionDiscovery::Get();
+  auto advert = discovery.hosted();
+  if (!advert) {
+    return;
+  }
+  // A session with no private slots can't take a private join: whatever the flag says (titles pass
+  // a BOOL array whose width we can't be sure of), the player takes a public slot. This is how the
+  // host's own join shows up as a filled slot, as Xbox LIVE reports it.
+  if (private_slot && advert->open_private == 0 && advert->filled_private == 0) {
+    private_slot = false;
+  }
+  auto& open = private_slot ? advert->open_private : advert->open_public;
+  auto& filled = private_slot ? advert->filled_private : advert->filled_public;
+  if (delta > 0 && open > 0) {
+    --open;
+    ++filled;
+  } else if (delta < 0 && filled > 0) {
+    ++open;
+    --filled;
+  } else {
+    REXKRNL_WARN("[net] hosted session: {} {} slot change ignored ({} open, {} filled)",
+                 delta > 0 ? "join into" : "leave from", private_slot ? "private" : "public", open,
+                 filled);
+  }
+  discovery.SetHosted(std::move(advert));
+}
+
+std::string DescribeContexts(memory::Memory* memory, uint32_t ptr, uint32_t count) {
+  std::string out;
+  for (uint32_t i = 0; ptr && i < count && i < 32; ++i) {
+    auto c = memory->TranslateVirtual(ptr + i * kUserContextSize);
+    out += fmt::format("{}{:08X}={}", out.empty() ? "" : " ", memory::load_and_swap<uint32_t>(c),
+                       memory::load_and_swap<uint32_t>(c + 4));
+  }
+  return out.empty() ? "none" : out;
+}
+
+std::string DescribeProperties(memory::Memory* memory, uint32_t ptr, uint32_t count) {
+  std::string out;
+  for (uint32_t i = 0; ptr && i < count && i < 32; ++i) {
+    auto p = memory->TranslateVirtual(ptr + i * kUserPropertySize);
+    out += fmt::format("{}{:08X}=type {} {}", out.empty() ? "" : " ",
+                       memory::load_and_swap<uint32_t>(p), p[8], Hex(p + kUserDataValueOffset, 8));
+  }
+  return out.empty() ? "none" : out;
+}
+
+// Xbox LIVE returns each result with the attributes the query asked for: the ids the title
+// searched with, in its order. A host's own list can hold more (presence, system properties), and
+// titles read results by that shape, so a result carries the query's ids with the host's values
+// (zero where the host never set one). A search with no attributes gets the host's list as is.
+struct ResultAttributes {
+  std::vector<SessionContext> contexts;
+  std::vector<SessionProperty> properties;
+};
+
+ResultAttributes ShapeResult(const SessionAdvert& advert, const std::vector<uint32_t>& query_contexts,
+                             const std::vector<uint32_t>& query_properties) {
+  ResultAttributes out;
+  if (query_contexts.empty() && query_properties.empty()) {
+    out.contexts = advert.contexts;
+    out.properties = advert.properties;
+    return out;
+  }
+  for (uint32_t id : query_contexts) {
+    SessionContext context{id, 0};
+    for (const auto& have : advert.contexts) {
+      if (have.id == id) {
+        context.value = have.value;
+      }
+    }
+    out.contexts.push_back(context);
+  }
+  for (uint32_t id : query_properties) {
+    SessionProperty property;
+    property.id = id;
+    property.type = PropertyType(id);
+    for (const auto& have : advert.properties) {
+      if (have.id == id) {
+        property = have;
+      }
+    }
+    out.properties.push_back(property);
+  }
+  return out;
+}
+
+// XSessionSearch / XSessionSearchEx (same first 32 bytes): asks the hosts on
+// this LAN, this PC and net_host_ip, and writes what they advertise.
+X_HRESULT SearchSessions(const char* name, uint8_t* buffer, uint32_t buffer_length,
+                         memory::Memory* memory, KernelState* kernel_state) {
+  if (buffer_length < 32) {
+    REXKRNL_WARN("[net] {}: short buffer ({} bytes)", name, buffer_length);
+    return X_E_INVALIDARG;
+  }
+  uint32_t proc_index = memory::load_and_swap<uint32_t>(buffer + 0);
+  uint32_t user_index = memory::load_and_swap<uint32_t>(buffer + 4);
+  uint32_t max_results = memory::load_and_swap<uint32_t>(buffer + 8);
+  uint16_t num_props = memory::load_and_swap<uint16_t>(buffer + 12);
+  uint16_t num_ctx = memory::load_and_swap<uint16_t>(buffer + 14);
+  uint32_t props_ptr = memory::load_and_swap<uint32_t>(buffer + 16);
+  uint32_t ctx_ptr = memory::load_and_swap<uint32_t>(buffer + 20);
+  uint32_t results_size = memory::load_and_swap<uint32_t>(buffer + 24);
+  uint32_t results_ptr = memory::load_and_swap<uint32_t>(buffer + 28);
+  REXKRNL_INFO("[net] {}(query {}, user {}, up to {} results, {} byte buffer at {:08X}); "
+               "contexts: {}; properties: {}",
+               name, proc_index, user_index, max_results, results_size, results_ptr,
+               DescribeContexts(memory, ctx_ptr, num_ctx),
+               DescribeProperties(memory, props_ptr, num_props));
+  // Guest heap pointers are far above 64 KB; anything lower means the layout
+  // is not what we think, and writing through it would corrupt memory.
+  if (results_ptr < 0x10000) {
+    REXKRNL_ERROR("[net] {}: unexpected argument layout (results {:08X}); not writing results",
+                  name, results_ptr);
+    return X_E_INVALIDARG;
+  }
+  // XSESSION_SEARCHRESULT_HEADER { DWORD dwSearchResults; RESULT* pResults; }
+  constexpr uint32_t kHeaderSize = 8;
+  if (results_size < kHeaderSize) {
+    REXKRNL_WARN("[net] {}: {} byte buffer can't hold the result header", name, results_size);
+    return kInsufficientBuffer;
+  }
+
+  StartDiscovery(kernel_state);
+  auto found = SessionDiscovery::Get().Search(kSearchTimeoutMs);
+  // Sessions with no open slot can't be joined; don't offer them.
+  found.erase(std::remove_if(found.begin(), found.end(),
+                             [](const FoundSession& f) {
+                               return f.advert.open_public + f.advert.open_private == 0;
+                             }),
+              found.end());
+
+  std::vector<uint32_t> query_contexts, query_properties;
+  for (uint32_t i = 0; ctx_ptr && i < num_ctx && i < 64; ++i) {
+    query_contexts.push_back(
+        memory::load_and_swap<uint32_t>(memory->TranslateVirtual(ctx_ptr + i * kUserContextSize)));
+  }
+  for (uint32_t i = 0; props_ptr && i < num_props && i < 64; ++i) {
+    query_properties.push_back(memory::load_and_swap<uint32_t>(
+        memory->TranslateVirtual(props_ptr + i * kUserPropertySize)));
+  }
+  std::vector<ResultAttributes> shaped;
+  for (const auto& f : found) {
+    shaped.push_back(ShapeResult(f.advert, query_contexts, query_properties));
+  }
+
+  // Results first, then each result's properties and contexts.
+  uint32_t count = 0;
+  uint32_t needed = kHeaderSize;
+  for (size_t n = 0; n < found.size(); ++n) {
+    uint32_t size = kSearchResultSize + uint32_t(shaped[n].contexts.size()) * kUserContextSize +
+                    uint32_t(shaped[n].properties.size()) * kUserPropertySize;
+    if (count >= max_results || needed + size > results_size) {
+      break;
+    }
+    needed += size;
+    ++count;
+  }
+  auto header = memory->TranslateVirtual(results_ptr);
+  const uint32_t first_result = results_ptr + kHeaderSize;
+  uint32_t extra = first_result + count * kSearchResultSize;
+  std::memset(header, 0, needed);
+  memory::store_and_swap<uint32_t>(header + 0, count);
+  memory::store_and_swap<uint32_t>(header + 4, count ? first_result : 0);
+  for (uint32_t i = 0; i < count; ++i) {
+    const auto& a = found[i].advert;
+    const auto& attrs = shaped[i];
+    auto r = memory->TranslateVirtual(first_result + i * kSearchResultSize);
+    std::memcpy(r, a.session_info.data(), kSessionInfoSize);
+    memory::store_and_swap<uint32_t>(r + 60, a.open_public);
+    memory::store_and_swap<uint32_t>(r + 64, a.open_private);
+    memory::store_and_swap<uint32_t>(r + 68, a.filled_public);
+    memory::store_and_swap<uint32_t>(r + 72, a.filled_private);
+    memory::store_and_swap<uint32_t>(r + 76, uint32_t(attrs.properties.size()));
+    memory::store_and_swap<uint32_t>(r + 80, uint32_t(attrs.contexts.size()));
+    const uint32_t props_va = attrs.properties.empty() ? 0 : extra;
+    for (const auto& prop : attrs.properties) {
+      auto p = memory->TranslateVirtual(extra);
+      memory::store_and_swap<uint32_t>(p, prop.id);
+      p[8] = prop.type;
+      std::memcpy(p + kUserDataValueOffset, prop.value.data(), 8);
+      extra += kUserPropertySize;
+    }
+    const uint32_t ctx_va = attrs.contexts.empty() ? 0 : extra;
+    for (const auto& ctx : attrs.contexts) {
+      auto c = memory->TranslateVirtual(extra);
+      memory::store_and_swap<uint32_t>(c, ctx.id);
+      memory::store_and_swap<uint32_t>(c + 4, ctx.value);
+      extra += kUserContextSize;
+    }
+    memory::store_and_swap<uint32_t>(r + 84, props_va);
+    memory::store_and_swap<uint32_t>(r + 88, ctx_va);
+    REXKRNL_INFO("[net] {}: result {} = session {:016X} hosted by '{}' ({}/{} public open); "
+                 "{} contexts, {} properties (host set {} and {})",
+                 name, i, a.session_id(), a.host_gamertag, a.open_public,
+                 a.open_public + a.filled_public, attrs.contexts.size(), attrs.properties.size(),
+                 a.contexts.size(), a.properties.size());
+  }
+  if (count < found.size()) {
+    REXKRNL_WARN("[net] {}: {} of {} sessions fit (max {} results, {} byte buffer)", name, count,
+                 found.size(), max_results, results_size);
+  }
+  REXKRNL_INFO("[net] {}(query {}) -> {} session(s)", name, proc_index, count);
+  return X_E_SUCCESS;
+}
