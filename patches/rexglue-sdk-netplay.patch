diff --git a/tests/unit/system/profile_slot_test.cpp b/tests/unit/system/profile_slot_test.cpp
new file mode 100644
index 0000000..85cd7a5
--- /dev/null
+++ b/tests/unit/system/profile_slot_test.cpp
@@ -0,0 +1,68 @@
+/**
+ * Unit tests for ProfileSlot
+ *
+ * Tests that the signed-in profile lands on the slot the title will treat as
+ * active: the highest connected pad at its first profile query.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xam/profile_slot.h>
+
+using rex::system::xam::ProfileSlot;
+
+TEST_CASE("Profile is on slot 0 before any pad is polled", "[profile]") {
+  ProfileSlot p;
+  CHECK(p.slot() == 0);
+  // That query didn't lock anything in.
+  p.NotePad(2, true);
+  CHECK(p.slot() == 2);
+}
+
+TEST_CASE("A single pad on slot 0 keeps the profile there", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(0, true);
+  p.NotePad(1, false);
+  CHECK(p.slot() == 0);
+}
+
+TEST_CASE("Mirrored pads put the profile on the higher slot", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(0, true);
+  p.NotePad(1, true);
+  p.NotePad(2, false);
+  p.NotePad(3, false);
+  CHECK(p.slot() == 1);
+}
+
+TEST_CASE("The choice is locked after the first query", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(0, true);
+  CHECK(p.slot() == 0);
+  p.NotePad(3, true);
+  CHECK(p.slot() == 0);
+}
+
+TEST_CASE("A pad that disconnected before the query doesn't count", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(1, true);
+  p.NotePad(1, false);
+  p.NotePad(0, true);
+  CHECK(p.slot() == 0);
+}
+
+TEST_CASE("A pinned profile ignores pads", "[profile]") {
+  ProfileSlot p;
+  p.Pin(2);
+  p.NotePad(0, true);
+  p.NotePad(1, true);
+  CHECK(p.slot() == 2);
+  CHECK(p.pinned());
+}
+
+TEST_CASE("Out-of-range pads are ignored", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(4, true);
+  p.NotePad(0xFF, true);
+  CHECK(p.slot() == 0);
+}
diff --git a/tests/unit/system/xnet_address_table_test.cpp b/tests/unit/system/xnet_address_table_test.cpp
new file mode 100644
index 0000000..74a2023
--- /dev/null
+++ b/tests/unit/system/xnet_address_table_test.cpp
@@ -0,0 +1,215 @@
+/**
+ * Unit tests for XNetAddressTable
+ *
+ * Tests virtual address allocation, port shifting for several instances on
+ * one host, and translation in both directions.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xnet_address_table.h>
+
+using namespace rex::system;
+
+namespace {
+constexpr uint32_t kLanA = 0xC0A80105;  // 192.168.1.5
+constexpr uint32_t kLanB = 0xC0A80106;  // 192.168.1.6
+constexpr uint16_t kGamePort = 1000;
+}  // namespace
+
+TEST_CASE("Advertised port round-trips the port offset", "[xnet]") {
+  CHECK(XNetAddressTable::AdvertisedPort(0) == kXNetBasePort);
+  CHECK(XNetAddressTable::OffsetFromAdvertisedPort(kXNetBasePort + 1) == 1);
+  CHECK(XNetAddressTable::OffsetFromAdvertisedPort(XNetAddressTable::AdvertisedPort(-4)) == -4);
+  CHECK(XNetAddressTable::OffsetFromAdvertisedPort(0) == 0);
+}
+
+TEST_CASE("Register allocates stable virtual addresses", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t a = table.Register({kLanA, 0});
+  uint32_t b = table.Register({kLanB, 0});
+
+  CHECK(XNetAddressTable::IsVirtual(a));
+  CHECK(XNetAddressTable::IsVirtual(b));
+  CHECK(a != b);
+  CHECK(table.Register({kLanA, 0}) == a);
+  CHECK(table.Lookup(a) == XNetPeer{kLanA, 0});
+  CHECK(table.Find({kLanB, 0}) == b);
+  CHECK_FALSE(XNetAddressTable::IsVirtual(kLanA));
+}
+
+TEST_CASE("Same IP with different offsets are different peers", "[xnet]") {
+  XNetAddressTable table;
+  CHECK(table.Register({kLanA, 0}) != table.Register({kLanA, 1}));
+}
+
+TEST_CASE("Unregister frees the slot for reuse", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t a = table.Register({kLanA, 0});
+  table.Register({kLanB, 0});
+
+  CHECK(table.Unregister(a));
+  CHECK_FALSE(table.Lookup(a));
+  CHECK_FALSE(table.Unregister(a));
+  CHECK(table.Register({0x0A000001, 0}) == a);
+}
+
+TEST_CASE("Lookup rejects non-virtual and unknown addresses", "[xnet]") {
+  XNetAddressTable table;
+  CHECK_FALSE(table.Lookup(kLanA));
+  CHECK_FALSE(table.Lookup(XNetAddressTable::kVirtualPrefix | 7));
+  CHECK_FALSE(table.Lookup(XNetAddressTable::kVirtualPrefix));
+}
+
+TEST_CASE("Bind ports shift by the local offset", "[xnet]") {
+  XNetAddressTable table;
+  CHECK(table.HostBindPort(kGamePort) == kGamePort);
+  table.SetLocalPortOffset(1);
+  CHECK(table.HostBindPort(kGamePort) == kGamePort + 1);
+  CHECK(table.HostBindPort(0) == 0);
+  table.SetLocalPortOffset(10);
+  CHECK(table.HostBindPort(0xFFFF) == 0xFFFF);  // would overflow; left alone
+}
+
+TEST_CASE("ToWire routes virtual destinations to the peer", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t b = table.Register({kLanB, 2});
+
+  CHECK(table.ToWire({b, kGamePort}) == XNetEndpoint{kLanB, kGamePort + 2});
+  CHECK(table.ToWire({kLanA, 53}) == XNetEndpoint{kLanA, 53});
+  // Unregistered virtual addresses pass through; the OS will reject them.
+  uint32_t unknown = XNetAddressTable::kVirtualPrefix | 99;
+  CHECK(table.ToWire({unknown, kGamePort}) == XNetEndpoint{unknown, kGamePort});
+}
+
+TEST_CASE("FromWire maps a known peer back to its virtual address", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t b = table.Register({kLanB, 2});
+
+  CHECK(table.FromWire({kLanB, kGamePort + 2}, kGamePort) == XNetEndpoint{b, kGamePort});
+  // A single peer on that IP matches even if the port differs from ours.
+  CHECK(table.FromWire({kLanB, 5002}, kGamePort) == XNetEndpoint{b, 5000});
+  CHECK(table.FromWire({kLanA, 1234}, kGamePort) == XNetEndpoint{kLanA, 1234});
+}
+
+TEST_CASE("FromWire tells apart instances on one host", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t first = table.Register({kLanA, 0});
+  uint32_t second = table.Register({kLanA, 1});
+
+  CHECK(table.FromWire({kLanA, kGamePort}, kGamePort) == XNetEndpoint{first, kGamePort});
+  CHECK(table.FromWire({kLanA, kGamePort + 1}, kGamePort) == XNetEndpoint{second, kGamePort});
+  // Ambiguous and no port match: pass through untouched.
+  CHECK(table.FromWire({kLanA, 7000}, kGamePort) == XNetEndpoint{kLanA, 7000});
+}
+
+TEST_CASE("Round trip between two instances on one host", "[xnet]") {
+  // Instance A runs with offset 0, instance B with offset 1. Each has
+  // registered the other's XNADDR.
+  XNetAddressTable a;
+  XNetAddressTable b;
+  a.SetLocalPortOffset(0);
+  b.SetLocalPortOffset(1);
+  uint32_t b_as_seen_by_a = a.Register({kLanA, 1});
+  uint32_t a_as_seen_by_b = b.Register({kLanA, 0});
+
+  // A sends to B's virtual address; it must land on B's shifted bind port.
+  XNetEndpoint wire = a.ToWire({b_as_seen_by_a, kGamePort});
+  CHECK(wire == XNetEndpoint{kLanA, b.HostBindPort(kGamePort)});
+
+  // B receives from A's real bind port and sees A's virtual address.
+  XNetEndpoint seen = b.FromWire({kLanA, a.HostBindPort(kGamePort)}, kGamePort);
+  CHECK(seen == XNetEndpoint{a_as_seen_by_b, kGamePort});
+}
+
+TEST_CASE("A peer at our own address is reached over loopback", "[xnet]") {
+  XNetAddressTable table;
+  table.SetLocalIp(kLanA);
+  uint32_t same_pc = table.Register({kLanA, 1});
+  uint32_t remote = table.Register({kLanB, 0});
+
+  CHECK(table.ToWire({same_pc, kGamePort}) == XNetEndpoint{XNetAddressTable::kLoopback, kGamePort + 1});
+  // A remote peer keeps its real address.
+  CHECK(table.ToWire({remote, kGamePort}) == XNetEndpoint{kLanB, kGamePort});
+}
+
+TEST_CASE("A loopback sender maps back to the same-PC peer", "[xnet]") {
+  // We are instance 1; the peer is instance 0 on the same PC.
+  XNetAddressTable table;
+  table.SetLocalIp(kLanA);
+  table.SetLocalPortOffset(1);
+  uint32_t same_pc = table.Register({kLanA, 0});
+
+  CHECK(table.FromWire({XNetAddressTable::kLoopback, kGamePort}, kGamePort - 0) ==
+        XNetEndpoint{same_pc, kGamePort});
+  // Without a local address set, a loopback sender is just another host to learn.
+  XNetAddressTable plain;
+  XNetEndpoint seen = plain.FromWire({XNetAddressTable::kLoopback, kGamePort}, kGamePort);
+  CHECK(XNetAddressTable::IsVirtual(seen.ip));
+  CHECK(plain.Lookup(seen.ip) == XNetPeer{XNetAddressTable::kLoopback, 0});
+}
+
+TEST_CASE("Two instances on one PC talk over loopback", "[xnet]") {
+  // A runs offset 0, B offset 1, both at the PC's LAN address.
+  XNetAddressTable a;
+  XNetAddressTable b;
+  a.SetLocalIp(kLanA);
+  b.SetLocalIp(kLanA);
+  a.SetLocalPortOffset(0);
+  b.SetLocalPortOffset(1);
+  uint32_t b_seen_by_a = a.Register({kLanA, 1});
+  uint32_t a_seen_by_b = b.Register({kLanA, 0});
+
+  XNetEndpoint wire = a.ToWire({b_seen_by_a, kGamePort});
+  CHECK(wire == XNetEndpoint{XNetAddressTable::kLoopback, b.HostBindPort(kGamePort)});
+  // B receives it from A's bind port, over loopback, and sees A's virtual address.
+  CHECK(b.FromWire({XNetAddressTable::kLoopback, a.HostBindPort(kGamePort)}, kGamePort) ==
+        XNetEndpoint{a_seen_by_b, kGamePort});
+}
+
+TEST_CASE("An unknown sender gets its own address, never ours", "[xnet]") {
+  // A host registers itself (its own XNADDR); a joiner on the same PC then sends from
+  // loopback with offset 1. It must not be mistaken for the host.
+  XNetAddressTable host;
+  host.SetLocalIp(kLanA);
+  host.SetLocalPortOffset(0);
+  uint32_t self = host.Register({kLanA, 0});
+
+  XNetEndpoint seen = host.FromWire({XNetAddressTable::kLoopback, kGamePort + 1}, kGamePort);
+  CHECK(seen.ip != self);
+  CHECK(XNetAddressTable::IsVirtual(seen.ip));
+  CHECK(seen.port == kGamePort);
+  // It is the peer the title will later learn from the joiner's XNADDR.
+  CHECK(host.Lookup(seen.ip) == XNetPeer{kLanA, 1});
+  CHECK(host.Register({kLanA, 1}) == seen.ip);
+  // The same sender maps to the same address.
+  CHECK(host.FromWire({XNetAddressTable::kLoopback, kGamePort + 1}, kGamePort) == seen);
+}
+
+TEST_CASE("Traffic that is not a peer passes through", "[xnet]") {
+  XNetAddressTable table;
+  table.SetLocalIp(kLanA);
+  table.SetLocalPortOffset(0);
+  table.Register({kLanA, 0});
+  // Our own address and offset: not registered as a new peer, left as is.
+  CHECK(table.FromWire({XNetAddressTable::kLoopback, kGamePort}, kGamePort) ==
+        XNetEndpoint{XNetAddressTable::kLoopback, kGamePort});
+  // A port below the game port (DNS and the like), and one far above it.
+  CHECK(table.FromWire({kLanB, 53}, kGamePort) == XNetEndpoint{kLanB, 53});
+  CHECK(table.FromWire({kLanB, kGamePort + 100}, kGamePort) == XNetEndpoint{kLanB, kGamePort + 100});
+  // A socket with no game port (ephemeral) never creates peers.
+  CHECK(table.FromWire({kLanB, kGamePort}, 0) == XNetEndpoint{kLanB, kGamePort});
+}
+
+TEST_CASE("A remote joiner is registered on first contact", "[xnet]") {
+  XNetAddressTable host;
+  host.SetLocalIp(kLanA);
+  host.SetLocalPortOffset(0);
+  host.Register({kLanA, 0});
+
+  XNetEndpoint seen = host.FromWire({kLanB, kGamePort}, kGamePort);
+  CHECK(XNetAddressTable::IsVirtual(seen.ip));
+  CHECK(host.Lookup(seen.ip) == XNetPeer{kLanB, 0});
+  // Replies to the virtual address go back to the joiner's real endpoint.
+  CHECK(host.ToWire({seen.ip, kGamePort}) == XNetEndpoint{kLanB, kGamePort});
+}
diff --git a/tests/unit/system/xsession_discovery_test.cpp b/tests/unit/system/xsession_discovery_test.cpp
new file mode 100644
index 0000000..0f33542
--- /dev/null
+++ b/tests/unit/system/xsession_discovery_test.cpp
@@ -0,0 +1,86 @@
+/**
+ * @file        tests/unit/system/xsession_discovery_test.cpp
+ * @brief       Session discovery wire format
+ */
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xsession_discovery.h>
+
+using namespace rex::system;
+
+namespace {
+
+constexpr uint32_t kTitle = 0x545107E0;
+
+SessionAdvert SampleAdvert() {
+  SessionAdvert a;
+  a.title_id = kTitle;
+  for (size_t i = 0; i < a.session_info.size(); ++i) {
+    a.session_info[i] = uint8_t(0x80 + i);
+  }
+  a.open_public = 1;
+  a.open_private = 0;
+  a.filled_public = 1;
+  a.filled_private = 0;
+  a.host_gamertag = "Superstar1393";
+  a.contexts = {{0x00008001, 1}, {0x00000003, 2}};
+  a.properties = {{0x10000001, 1, {0, 0, 0, 0, 0, 0, 0, 7}}};
+  a.qos_data = {1, 2, 3, 4, 5};
+  return a;
+}
+
+}  // namespace
+
+TEST_CASE("Query round-trips its nonce", "[discovery]") {
+  auto q = EncodeQuery(kTitle, 0xCAFEF00D);
+  auto nonce = DecodeQuery(q.data(), q.size(), kTitle);
+  REQUIRE(nonce);
+  CHECK(*nonce == 0xCAFEF00D);
+}
+
+TEST_CASE("Query for another title is ignored", "[discovery]") {
+  auto q = EncodeQuery(kTitle, 1);
+  CHECK_FALSE(DecodeQuery(q.data(), q.size(), kTitle + 1));
+}
+
+TEST_CASE("Advert round-trips everything the title sees", "[discovery]") {
+  auto a = SampleAdvert();
+  auto bytes = EncodeAdvert(a, 42);
+  uint32_t nonce = 0;
+  auto b = DecodeAdvert(bytes.data(), bytes.size(), kTitle, &nonce);
+  REQUIRE(b);
+  CHECK(*b == a);
+  CHECK(nonce == 42);
+  CHECK(b->session_id() == 0x8081828384858687ull);
+}
+
+TEST_CASE("Advert is not mistaken for a query and vice versa", "[discovery]") {
+  auto a = EncodeAdvert(SampleAdvert(), 1);
+  CHECK_FALSE(DecodeQuery(a.data(), a.size(), kTitle));
+  auto q = EncodeQuery(kTitle, 1);
+  CHECK_FALSE(DecodeAdvert(q.data(), q.size(), kTitle));
+}
+
+TEST_CASE("Truncated or padded adverts are rejected", "[discovery]") {
+  auto bytes = EncodeAdvert(SampleAdvert(), 1);
+  for (size_t cut = 0; cut < bytes.size(); ++cut) {
+    CHECK_FALSE(DecodeAdvert(bytes.data(), cut, kTitle));
+  }
+  bytes.push_back(0);
+  CHECK_FALSE(DecodeAdvert(bytes.data(), bytes.size(), kTitle));
+}
+
+TEST_CASE("Other protocol versions are ignored", "[discovery]") {
+  auto bytes = EncodeAdvert(SampleAdvert(), 1);
+  bytes[4] = kDiscoveryVersion + 1;
+  CHECK_FALSE(DecodeAdvert(bytes.data(), bytes.size(), kTitle));
+}
+
+TEST_CASE("An empty advert still fits", "[discovery]") {
+  SessionAdvert a;
+  a.title_id = kTitle;
+  auto bytes = EncodeAdvert(a, 7);
+  auto b = DecodeAdvert(bytes.data(), bytes.size(), kTitle);
+  REQUIRE(b);
+  CHECK(*b == a);
+}
