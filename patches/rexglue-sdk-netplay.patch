+// requested spec, each with zero rows.
+class XEmptyStatsEnumerator : public XEnumerator {
+ public:
+  XEmptyStatsEnumerator(KernelState* kernel_state, uint32_t results_size,
+                        std::vector<uint32_t> view_ids)
+      : XEnumerator(kernel_state, 1, results_size), view_ids_(std::move(view_ids)) {}
+
+  uint32_t WriteItems(uint32_t buffer_ptr, uint8_t* buffer_data, uint32_t* written_count) override {
+    if (written_) {
+      return X_ERROR_NO_MORE_FILES;
+    }
+    written_ = true;
+    // XUSER_STATS_READ_RESULTS { DWORD dwNumViews; XUSER_STATS_VIEW* pViews; }
+    memory::store_and_swap<uint32_t>(buffer_data + 0, uint32_t(view_ids_.size()));
+    memory::store_and_swap<uint32_t>(buffer_data + 4, view_ids_.empty() ? 0 : buffer_ptr + 8);
+    // XUSER_STATS_VIEW { DWORD dwViewId, dwTotalViewRows, dwNumRows; ROW* pRows; }
+    for (size_t i = 0; i < view_ids_.size(); ++i) {
+      uint8_t* view = buffer_data + 8 + i * 16;
+      memory::store_and_swap<uint32_t>(view + 0, view_ids_[i]);
+      memory::store_and_swap<uint32_t>(view + 4, 0);
+      memory::store_and_swap<uint32_t>(view + 8, 0);
+      memory::store_and_swap<uint32_t>(view + 12, 0);
+    }
+    if (written_count) {
+      *written_count = 1;
+    }
+    return X_ERROR_SUCCESS;
+  }
+
+ private:
+  std::vector<uint32_t> view_ids_;
+  bool written_ = false;
+};
