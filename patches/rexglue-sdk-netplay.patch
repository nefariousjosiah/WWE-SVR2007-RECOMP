+constexpr uint32_t XNET_QOS_LISTEN_DISABLE = 0x02;
+constexpr uint32_t XNET_QOS_LISTEN_SET_DATA = 0x04;
+constexpr uint32_t XNET_QOS_LISTEN_SET_BITSPERSEC = 0x08;
+constexpr uint32_t XNET_QOS_LISTEN_RELEASE = 0x10;
+
+u32 NetDll_XNetQosListen_entry(u32 caller, ppc_ptr_t<XNKID> id, mapped_void data, u32 data_size,
+                               u32 bits_per_sec, u32 flags) {
+  if (!id) {
+    REXKRNL_WARN("[net] XNetQosListen: no session id");
+    return kWSAEINVAL;
+  }
+  uint64_t key = 0;
+  for (int i = 0; i < 8; ++i) {
+    key = (key << 8) | id->ab[i];
+  }
+  std::lock_guard<std::mutex> lock(qos_mutex);
+  if (flags & XNET_QOS_LISTEN_RELEASE) {
+    qos_listeners.erase(key);
+    REXKRNL_DEBUG("[net] XNetQosListen(session {:016X}) -> released", key);
+    return 0;
+  }
+  auto& listener = qos_listeners[key];
+  if (flags & XNET_QOS_LISTEN_SET_DATA) {
+    auto bytes = data ? data.as<uint8_t*>() : nullptr;
+    listener.data.assign(bytes, bytes ? bytes + uint32_t(data_size) : nullptr);
+  }
+  if (flags & XNET_QOS_LISTEN_SET_BITSPERSEC) {
+    listener.bits_per_sec = bits_per_sec;
+  }
+  if (flags & XNET_QOS_LISTEN_ENABLE) {
+    listener.enabled = true;
+  }
+  if (flags & XNET_QOS_LISTEN_DISABLE) {
+    listener.enabled = false;
+  }
+  REXKRNL_DEBUG(
+      "[net] XNetQosListen(session {:016X}, flags {:02X}) -> {} , {} data bytes {:02X}, "
+      "{} bps",
+      key, uint32_t(flags), listener.enabled ? "enabled" : "disabled", listener.data.size(),
+      fmt::join(listener.data, ""), listener.bits_per_sec);
+  return 0;
 }
 
