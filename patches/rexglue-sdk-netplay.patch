+/**
+ * @file        kernel/xam/xnet.h
+ * @brief       XNet pieces shared between xam_net.cpp and the XGI session app
+ */
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace rex::kernel::xam {
+
+// Guest structure sizes.
+constexpr size_t kXnAddrSize = 36;  // XNADDR
+constexpr size_t kXnKidSize = 8;    // XNKID
+constexpr size_t kXnKeySize = 16;   // XNKEY
+// XSESSION_INFO { XNKID sessionID; XNADDR hostAddress; XNKEY keyExchangeKey; }
+constexpr size_t kSessionInfoSize = kXnKidSize + kXnAddrSize + kXnKeySize;
+
+// XNKID high-nibble flags.
+constexpr uint8_t kXnKidSystemLink = 0x00;
+constexpr uint8_t kXnKidOnlinePeer = 0x80;
+
+// Writes this console's XNADDR (guest layout) to `out`. Returns the
+// XNET_GET_XNADDR_* status XNetGetTitleXnAddr reports.
+uint32_t FillTitleXnAddr(uint8_t* out);
+
+// Random bytes (peers must not generate the same IDs).
+void FillRandom(void* buffer, size_t length);
+
+// This instance's port offset (net_port - 3074): 0 for the first instance on a
+// PC, 1 for a second one, ...
+int32_t LocalPortOffset();
+
+}  // namespace rex::kernel::xam
diff --git a/include/rex/system/xam/profile_slot.h b/include/rex/system/xam/profile_slot.h
new file mode 100644
index 0000000..50bc3c0
--- /dev/null
+++ b/include/rex/system/xam/profile_slot.h
@@ -0,0 +1,79 @@
+/**
+ * @file        system/xam/profile_slot.h
+ * @brief       Which controller slot the signed-in profile belongs to
+ *
+ * Titles treat the pad that pressed Start as the active profile and refuse
+ * Xbox LIVE if that user index isn't signed in. They read every slot's sign-in
+ * state once at boot and cache it, so the slot has to be right before then.
+ *
+ * One physical pad often shows up in two slots (a real pad plus a Steam Input
+ * / DS4Windows virtual one, both reporting every press). Titles scan pads in
+ * order and keep the last one that pressed Start, so with mirrored pads they
+ * pick the highest slot. We do the same: the profile goes on the highest
+ * connected slot the title polled before its first profile query, and stays
+ * there. A single pad is always slot 0.
+ */
+#pragma once
+
+#include <cstdint>
+#include <mutex>
+
+namespace rex::system::xam {
+
+class ProfileSlot {
+ public:
+  static constexpr uint32_t kSlots = 4;
+  static constexpr uint16_t kStartButton = 0x0010;  // XINPUT_GAMEPAD_START
+
+  // Pins the profile to `slot`; automatic selection is off from then on.
+  void Pin(uint32_t slot) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    slot_ = slot % kSlots;
+    pinned_ = true;
+  }
+
+  // A pad the title polled, connected or not.
+  void NotePad(uint32_t pad, bool connected) {
+    if (pad >= kSlots) {
+      return;
+    }
+    std::lock_guard<std::mutex> lock(mutex_);
+    seen_ |= 1u << pad;
+    if (connected) {
+      connected_ |= 1u << pad;
+    } else {
+      connected_ &= ~(1u << pad);
+    }
+  }
+
+  // The profile's slot. The first call after the title polled a pad locks the
+  // choice in.
+  uint32_t slot() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!pinned_ && !locked_ && seen_) {
+      for (uint32_t pad = kSlots; pad-- > 0;) {
+        if (connected_ & (1u << pad)) {
+          slot_ = pad;
+          break;
+        }
+      }
+      locked_ = true;
+    }
+    return slot_;
+  }
+
+  bool pinned() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return pinned_;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  uint32_t slot_ = 0;
+  bool pinned_ = false;
+  bool locked_ = false;
+  uint32_t seen_ = 0;
+  uint32_t connected_ = 0;
+};
+
+}  // namespace rex::system::xam
