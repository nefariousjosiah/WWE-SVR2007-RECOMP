+// XUserCreateStatsEnumeratorBy{Rank,Xuid,Rating}: r4 says which, r5 is the
+// rank / rating pivot (the xuid variant passes it differently).
+u32 XamUserCreateStatsEnumerator_entry(u32 title_id, u32 kind, u32 pivot, u32 num_rows,
+                                       u32 num_specs, mapped_void specs_ptr,
+                                       mapped_u32 buffer_size_ptr, mapped_u32 handle_ptr) {
+  // XUSER_STATS_SPEC { DWORD dwViewId; DWORD dwNumColumnIds; WORD rgwColumnIds[64]; }
+  constexpr uint32_t kSpecSize = 8 + 64 * 2;
+  constexpr uint32_t kMaxSpecs = 64;
+  constexpr uint32_t kViewSize = 16, kRowSize = 48, kColumnSize = 24;
+  if (!buffer_size_ptr || !handle_ptr || (num_specs && !specs_ptr) || num_specs > kMaxSpecs) {
+    REXKRNL_WARN(
+        "[net] XamUserCreateStatsEnumerator(title {:08X}, kind {}, {} specs): bad "
+        "arguments",
+        uint32_t(title_id), uint32_t(kind), uint32_t(num_specs));
+    return X_ERROR_INVALID_PARAMETER;
+  }
+
+  // Size the buffer for a full answer, as Live would, so the title's buffer
+  // handling is the same as with real results.
+  std::vector<uint32_t> view_ids;
+  std::string views_text;
+  uint64_t size = 8;
+  auto specs = specs_ptr.as<uint8_t*>();
+  for (uint32_t i = 0; i < num_specs; ++i) {
+    uint32_t view_id = memory::load_and_swap<uint32_t>(specs + i * kSpecSize + 0);
+    uint32_t columns = std::min(memory::load_and_swap<uint32_t>(specs + i * kSpecSize + 4), 64u);
+    view_ids.push_back(view_id);
+    views_text += fmt::format("{}{}x{}", i ? " " : "", view_id, columns);
+    size += kViewSize + uint64_t(num_rows) * (kRowSize + uint64_t(columns) * kColumnSize);
+  }
+  uint32_t results_size = uint32_t(std::min<uint64_t>(size, 0x00100000));
+  *buffer_size_ptr = results_size;
+
+  auto e = object_ref<XEmptyStatsEnumerator>(
+      new XEmptyStatsEnumerator(REX_KERNEL_STATE(), results_size, std::move(view_ids)));
+  auto result = e->Initialize(0xFF, 0xFB, 0, 0, 0);
+  if (XFAILED(result)) {
+    REXKRNL_ERROR("[net] XamUserCreateStatsEnumerator: enumerator init failed: {:08X}", result);
+    return result;
+  }
+  *handle_ptr = e->handle();
+  REXKRNL_DEBUG(
+      "[net] XamUserCreateStatsEnumerator(title {:08X}, kind {}, pivot {}, {} rows, "
+      "views [{}]) -> empty leaderboard, {} bytes (stats not implemented yet)",
+      uint32_t(title_id), uint32_t(kind), uint32_t(pivot), uint32_t(num_rows), views_text,
+      results_size);
+  return X_ERROR_SUCCESS;
+}
