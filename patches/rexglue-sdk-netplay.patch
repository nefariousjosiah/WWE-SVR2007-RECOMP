diff --git a/src/system/xnet_address_table.cpp b/src/system/xnet_address_table.cpp
new file mode 100644
index 0000000..e2d65f2
--- /dev/null
+++ b/src/system/xnet_address_table.cpp
@@ -0,0 +1,165 @@
+/**
+ * @file        system/xnet_address_table.cpp
+ * @brief       XNet peer address mapping
+ */
+
+#include <rex/system/xnet_address_table.h>
+
+namespace rex::system {
+
+void XNetAddressTable::SetLocalPortOffset(int32_t offset) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  local_port_offset_ = offset;
+}
+
+int32_t XNetAddressTable::local_port_offset() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return local_port_offset_;
+}
+
+void XNetAddressTable::SetLocalIp(uint32_t ip) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  local_ip_ = ip;
+}
+
+uint32_t XNetAddressTable::local_ip() const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return local_ip_;
+}
+
+uint32_t XNetAddressTable::Register(const XNetPeer& peer) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  return RegisterLocked(peer);
+}
+
+uint32_t XNetAddressTable::RegisterLocked(const XNetPeer& peer) {
+  std::optional<size_t> free_slot;
+  for (size_t i = 0; i < peers_.size(); ++i) {
+    if (peers_[i] == peer) {
+      return kVirtualPrefix | uint32_t(i + 1);
+    }
+    if (!peers_[i] && !free_slot) {
+      free_slot = i;
+    }
+  }
+  if (free_slot) {
+    peers_[*free_slot] = peer;
+    return kVirtualPrefix | uint32_t(*free_slot + 1);
+  }
+  if (peers_.size() >= kMaxPeers) {
+    return 0;
+  }
+  peers_.push_back(peer);
+  return kVirtualPrefix | uint32_t(peers_.size());
+}
+
+std::optional<XNetPeer> XNetAddressTable::Lookup(uint32_t virtual_ip) const {
+  if (!IsVirtual(virtual_ip)) {
+    return std::nullopt;
+  }
+  uint32_t index = (virtual_ip & ~kVirtualMask) - 1;
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (index >= peers_.size()) {
+    return std::nullopt;
+  }
+  return peers_[index];
+}
+
+std::optional<uint32_t> XNetAddressTable::Find(const XNetPeer& peer) const {
+  std::lock_guard<std::mutex> lock(mutex_);
+  for (size_t i = 0; i < peers_.size(); ++i) {
+    if (peers_[i] == peer) {
+      return kVirtualPrefix | uint32_t(i + 1);
+    }
+  }
+  return std::nullopt;
+}
+
+bool XNetAddressTable::Unregister(uint32_t virtual_ip) {
+  if (!IsVirtual(virtual_ip)) {
+    return false;
+  }
+  uint32_t index = (virtual_ip & ~kVirtualMask) - 1;
+  std::lock_guard<std::mutex> lock(mutex_);
+  if (index >= peers_.size() || !peers_[index]) {
+    return false;
+  }
+  peers_[index].reset();
+  return true;
+}
+
+void XNetAddressTable::Clear() {
+  std::lock_guard<std::mutex> lock(mutex_);
+  peers_.clear();
+}
+
+uint16_t XNetAddressTable::ShiftPort(uint16_t port, int32_t offset) {
+  int32_t shifted = int32_t(port) + offset;
+  if (shifted < 1 || shifted > 0xFFFF) {
+    return port;
+  }
+  return static_cast<uint16_t>(shifted);
+}
+
+uint16_t XNetAddressTable::HostBindPort(uint16_t guest_port) const {
+  if (!guest_port) {
+    return 0;
+  }
+  return ShiftPort(guest_port, local_port_offset());
+}
+
+XNetEndpoint XNetAddressTable::ToWire(XNetEndpoint guest) const {
+  auto peer = Lookup(guest.ip);
+  if (!peer) {
+    return guest;
+  }
+  uint32_t ip = peer->ip;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (local_ip_ && ip == local_ip_) {
+      ip = kLoopback;
+    }
+  }
+  return {ip, ShiftPort(guest.port, peer->port_offset)};
+}
+
+XNetEndpoint XNetAddressTable::FromWire(XNetEndpoint wire, uint16_t local_guest_port) {
+  std::lock_guard<std::mutex> lock(mutex_);
+  // A sender on this PC arrives over loopback; its registered address is our own.
+  const uint32_t wire_ip = (local_ip_ && wire.ip == kLoopback) ? local_ip_ : wire.ip;
+  std::optional<size_t> only_match;
+  size_t match_count = 0;
+  for (size_t i = 0; i < peers_.size(); ++i) {
+    const auto& peer = peers_[i];
+    if (!peer || peer->ip != wire_ip) {
+      continue;
+    }
+    // Our own entry (a host registers itself) is never the sender.
+    if (local_ip_ && peer->ip == local_ip_ && peer->port_offset == local_port_offset_) {
+      continue;
+    }
+    uint16_t guest_port = ShiftPort(wire.port, -peer->port_offset);
+    if (local_guest_port && guest_port == local_guest_port) {
+      return {kVirtualPrefix | uint32_t(i + 1), guest_port};
+    }
+    only_match = i;
+    ++match_count;
+  }
+  if (match_count == 1) {
+    return {kVirtualPrefix | uint32_t(*only_match + 1),
+            ShiftPort(wire.port, -peers_[*only_match]->port_offset)};
+  }
+  if (match_count == 0 && local_guest_port && wire_ip) {
+    const int32_t offset = int32_t(wire.port) - int32_t(local_guest_port);
+    const bool is_self = local_ip_ && wire_ip == local_ip_ && offset == local_port_offset_;
+    if (offset >= 0 && offset <= kMaxAutoOffset && !is_self) {
+      uint32_t virtual_ip = RegisterLocked({wire_ip, offset});
+      if (virtual_ip) {
+        return {virtual_ip, local_guest_port};
+      }
+    }
+  }
+  return wire;
+}
+
+}  // namespace rex::system
