diff --git a/tests/unit/system/profile_slot_test.cpp b/tests/unit/system/profile_slot_test.cpp
new file mode 100644
index 0000000..85cd7a5
--- /dev/null
+++ b/tests/unit/system/profile_slot_test.cpp
@@ -0,0 +1,68 @@
+/**
+ * Unit tests for ProfileSlot
+ *
+ * Tests that the signed-in profile lands on the slot the title will treat as
+ * active: the highest connected pad at its first profile query.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xam/profile_slot.h>
+
+using rex::system::xam::ProfileSlot;
+
+TEST_CASE("Profile is on slot 0 before any pad is polled", "[profile]") {
+  ProfileSlot p;
+  CHECK(p.slot() == 0);
+  // That query didn't lock anything in.
+  p.NotePad(2, true);
+  CHECK(p.slot() == 2);
+}
+
+TEST_CASE("A single pad on slot 0 keeps the profile there", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(0, true);
+  p.NotePad(1, false);
+  CHECK(p.slot() == 0);
+}
+
+TEST_CASE("Mirrored pads put the profile on the higher slot", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(0, true);
+  p.NotePad(1, true);
+  p.NotePad(2, false);
+  p.NotePad(3, false);
+  CHECK(p.slot() == 1);
+}
+
+TEST_CASE("The choice is locked after the first query", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(0, true);
+  CHECK(p.slot() == 0);
+  p.NotePad(3, true);
+  CHECK(p.slot() == 0);
+}
+
+TEST_CASE("A pad that disconnected before the query doesn't count", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(1, true);
+  p.NotePad(1, false);
+  p.NotePad(0, true);
+  CHECK(p.slot() == 0);
+}
+
+TEST_CASE("A pinned profile ignores pads", "[profile]") {
+  ProfileSlot p;
+  p.Pin(2);
+  p.NotePad(0, true);
+  p.NotePad(1, true);
+  CHECK(p.slot() == 2);
+  CHECK(p.pinned());
+}
+
+TEST_CASE("Out-of-range pads are ignored", "[profile]") {
+  ProfileSlot p;
+  p.NotePad(4, true);
+  p.NotePad(0xFF, true);
+  CHECK(p.slot() == 0);
+}
diff --git a/tests/unit/system/xnet_address_table_test.cpp b/tests/unit/system/xnet_address_table_test.cpp
new file mode 100644
index 0000000..b8f5393
--- /dev/null
+++ b/tests/unit/system/xnet_address_table_test.cpp
@@ -0,0 +1,123 @@
+/**
+ * Unit tests for XNetAddressTable
+ *
+ * Tests virtual address allocation, port shifting for several instances on
+ * one host, and translation in both directions.
+ */
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xnet_address_table.h>
+
+using namespace rex::system;
+
+namespace {
+constexpr uint32_t kLanA = 0xC0A80105;  // 192.168.1.5
+constexpr uint32_t kLanB = 0xC0A80106;  // 192.168.1.6
+constexpr uint16_t kGamePort = 1000;
+}  // namespace
+
+TEST_CASE("Advertised port round-trips the port offset", "[xnet]") {
+  CHECK(XNetAddressTable::AdvertisedPort(0) == kXNetBasePort);
+  CHECK(XNetAddressTable::OffsetFromAdvertisedPort(kXNetBasePort + 1) == 1);
+  CHECK(XNetAddressTable::OffsetFromAdvertisedPort(XNetAddressTable::AdvertisedPort(-4)) == -4);
+  CHECK(XNetAddressTable::OffsetFromAdvertisedPort(0) == 0);
+}
+
+TEST_CASE("Register allocates stable virtual addresses", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t a = table.Register({kLanA, 0});
+  uint32_t b = table.Register({kLanB, 0});
+
+  CHECK(XNetAddressTable::IsVirtual(a));
+  CHECK(XNetAddressTable::IsVirtual(b));
+  CHECK(a != b);
+  CHECK(table.Register({kLanA, 0}) == a);
+  CHECK(table.Lookup(a) == XNetPeer{kLanA, 0});
+  CHECK(table.Find({kLanB, 0}) == b);
+  CHECK_FALSE(XNetAddressTable::IsVirtual(kLanA));
+}
+
+TEST_CASE("Same IP with different offsets are different peers", "[xnet]") {
+  XNetAddressTable table;
+  CHECK(table.Register({kLanA, 0}) != table.Register({kLanA, 1}));
+}
+
+TEST_CASE("Unregister frees the slot for reuse", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t a = table.Register({kLanA, 0});
+  table.Register({kLanB, 0});
+
+  CHECK(table.Unregister(a));
+  CHECK_FALSE(table.Lookup(a));
+  CHECK_FALSE(table.Unregister(a));
+  CHECK(table.Register({0x0A000001, 0}) == a);
+}
+
+TEST_CASE("Lookup rejects non-virtual and unknown addresses", "[xnet]") {
+  XNetAddressTable table;
+  CHECK_FALSE(table.Lookup(kLanA));
+  CHECK_FALSE(table.Lookup(XNetAddressTable::kVirtualPrefix | 7));
+  CHECK_FALSE(table.Lookup(XNetAddressTable::kVirtualPrefix));
+}
+
+TEST_CASE("Bind ports shift by the local offset", "[xnet]") {
+  XNetAddressTable table;
+  CHECK(table.HostBindPort(kGamePort) == kGamePort);
+  table.SetLocalPortOffset(1);
+  CHECK(table.HostBindPort(kGamePort) == kGamePort + 1);
+  CHECK(table.HostBindPort(0) == 0);
+  table.SetLocalPortOffset(10);
+  CHECK(table.HostBindPort(0xFFFF) == 0xFFFF);  // would overflow; left alone
+}
+
+TEST_CASE("ToWire routes virtual destinations to the peer", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t b = table.Register({kLanB, 2});
+
+  CHECK(table.ToWire({b, kGamePort}) == XNetEndpoint{kLanB, kGamePort + 2});
+  CHECK(table.ToWire({kLanA, 53}) == XNetEndpoint{kLanA, 53});
+  // Unregistered virtual addresses pass through; the OS will reject them.
+  uint32_t unknown = XNetAddressTable::kVirtualPrefix | 99;
+  CHECK(table.ToWire({unknown, kGamePort}) == XNetEndpoint{unknown, kGamePort});
+}
+
+TEST_CASE("FromWire maps a known peer back to its virtual address", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t b = table.Register({kLanB, 2});
+
+  CHECK(table.FromWire({kLanB, kGamePort + 2}, kGamePort) == XNetEndpoint{b, kGamePort});
+  // A single peer on that IP matches even if the port differs from ours.
+  CHECK(table.FromWire({kLanB, 5002}, kGamePort) == XNetEndpoint{b, 5000});
+  CHECK(table.FromWire({kLanA, 1234}, kGamePort) == XNetEndpoint{kLanA, 1234});
+}
+
+TEST_CASE("FromWire tells apart instances on one host", "[xnet]") {
+  XNetAddressTable table;
+  uint32_t first = table.Register({kLanA, 0});
+  uint32_t second = table.Register({kLanA, 1});
+
+  CHECK(table.FromWire({kLanA, kGamePort}, kGamePort) == XNetEndpoint{first, kGamePort});
+  CHECK(table.FromWire({kLanA, kGamePort + 1}, kGamePort) == XNetEndpoint{second, kGamePort});
+  // Ambiguous and no port match: pass through untouched.
+  CHECK(table.FromWire({kLanA, 7000}, kGamePort) == XNetEndpoint{kLanA, 7000});
+}
+
+TEST_CASE("Round trip between two instances on one host", "[xnet]") {
+  // Instance A runs with offset 0, instance B with offset 1. Each has
+  // registered the other's XNADDR.
+  XNetAddressTable a;
+  XNetAddressTable b;
+  a.SetLocalPortOffset(0);
+  b.SetLocalPortOffset(1);
+  uint32_t b_as_seen_by_a = a.Register({kLanA, 1});
+  uint32_t a_as_seen_by_b = b.Register({kLanA, 0});
+
+  // A sends to B's virtual address; it must land on B's shifted bind port.
+  XNetEndpoint wire = a.ToWire({b_as_seen_by_a, kGamePort});
+  CHECK(wire == XNetEndpoint{kLanA, b.HostBindPort(kGamePort)});
+
+  // B receives from A's real bind port and sees A's virtual address.
+  XNetEndpoint seen = b.FromWire({kLanA, a.HostBindPort(kGamePort)}, kGamePort);
+  CHECK(seen == XNetEndpoint{a_as_seen_by_b, kGamePort});
+}
