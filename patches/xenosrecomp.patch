new file mode 100644
index 0000000..063d928
--- /dev/null
+++ b/XenosRecomp/legacy_container.h
@@ -0,0 +1,163 @@
+#pragma once
+
+// Shader containers of an older XDK version (flags 0x102A0Exx, SvR 2007) hold the same data as the
+// 0x102A11xx layout the rest of XenosRecomp reads, arranged differently:
+//   header (6 dwords): flags, virtualSize, physicalSize, definitionTableOffset,
+//     constantTableOffset, shaderOffset (0x11: 9 dwords, the constant table first);
+//   definitions: an empty physical float4 section (a lone 0), then inline entries
+//     {u16 address, u16 count, values[count]}: below 0x2320 a float4 literal at register
+//     (address - 0x300) / 16 (pixel shader registers 256 up, as 0x11 numbers them; count in
+//     dwords), from 0x2320 up an int4 as in 0x11;
+//   shader block: 0x11's physicalOffset and size are implied (the microcode is the whole physical
+//     part) and its next words come as field8, fieldC, field10, (unused), interpolatorInfo,
+//     (unused); a vertex shader has one more word (0) after field20, before its element list.
+// ConvertLegacyShaderContainer builds the 0x11 equivalent: header, constant table, definitions
+// (the float4 literals appended after the microcode, as physical data), shader block, microcode.
+// Checked against all 332 SvR 2007 shaders (tools/native/check07.py-style walk).
+
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+inline bool IsLegacyShaderContainer(const uint8_t* data)
+{
+    return (uint32_t(data[0]) << 24 | uint32_t(data[1]) << 16 | uint32_t(data[2]) << 8) == 0x102A0E00;
+}
+
+inline std::vector<uint8_t> ConvertLegacyShaderContainer(const uint8_t* src)
+{
+    auto rd = [&](uint32_t offset) -> uint32_t
+    {
+        const uint8_t* p = src + offset;
+        return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+    };
+    std::vector<uint8_t> out;
+    auto wr = [&](uint32_t value)
+    {
+        out.push_back(uint8_t(value >> 24));
+        out.push_back(uint8_t(value >> 16));
+        out.push_back(uint8_t(value >> 8));
+        out.push_back(uint8_t(value));
+    };
+    auto patch = [&](size_t offset, uint32_t value)
+    {
+        out[offset] = uint8_t(value >> 24);
+        out[offset + 1] = uint8_t(value >> 16);
+        out[offset + 2] = uint8_t(value >> 8);
+        out[offset + 3] = uint8_t(value);
+    };
+
+    const uint32_t flags = rd(0x00);
+    const uint32_t virtualSize = rd(0x04);
+    const uint32_t physicalSize = rd(0x08);
+    const uint32_t definitionTableOffset = rd(0x0C);
+    const uint32_t constantTableOffset = rd(0x10);
+    const uint32_t shaderOffset = rd(0x14);
+    const bool isPixelShader = (flags & 0x1) == 0;
+
+    // Header, filled in at the end.
+    for (int i = 0; i < 9; i++)
+        wr(0);
+
+    // Constant table: a size, then that many bytes.
+    const size_t newConstantTable = out.size();
+    const uint32_t constantTableSize = rd(constantTableOffset);
+    out.insert(out.end(), src + constantTableOffset, src + constantTableOffset + 4 + constantTableSize);
+    while (out.size() % 4)
+        out.push_back(0);
+
+    // Definitions.
+    std::vector<uint32_t> literals;  // float4 literal values, appended after the microcode
+    size_t newDefinitionTable = 0;
+    if (definitionTableOffset != 0)
+    {
+        newDefinitionTable = out.size();
+        for (uint32_t i = 0; i < 4; i++)
+            wr(rd(definitionTableOffset + 4 * i));
+        const size_t sizeAt = out.size();
+        wr(0);
+        const size_t start = out.size();
+
+        const uint32_t size = rd(definitionTableOffset + 16);
+        const uint32_t first = definitionTableOffset + 20;
+        const uint32_t end = first + size;
+        uint32_t at = first;
+        std::vector<uint32_t> floats, ints;
+        // Physical float4 definitions (0x11 style), if any.
+        while (at + 8 <= end && rd(at) != 0)
+        {
+            floats.push_back(rd(at));
+            floats.push_back(rd(at + 4));
+            at += 8;
+        }
+        at += 4;
+        // Inline entries.
+        while (at + 4 <= end && rd(at) != 0)
+        {
+            const uint32_t header = rd(at);
+            const uint32_t address = header >> 16;
+            const uint32_t count = header & 0xFFFF;
+            if (address < 0x2320)
+            {
+                const uint32_t registerIndex = (address - 0x300) / 16;
+                floats.push_back(registerIndex << 16 | count);
+                floats.push_back(physicalSize + uint32_t(literals.size()) * 4);
+                for (uint32_t k = 0; k < count; k++)
+                    literals.push_back(rd(at + 4 + 4 * k));
+            }
+            else
+            {
+                ints.push_back(header);
+                for (uint32_t k = 0; k < count; k++)
+                    ints.push_back(rd(at + 4 + 4 * k));
+            }
+            at += 4 + 4 * count;
+        }
+        for (uint32_t v : floats)
+            wr(v);
+        wr(0);
+        for (uint32_t v : ints)
+            wr(v);
+        wr(0);
+        patch(sizeAt, uint32_t(out.size() - start));
+    }
+
+    // Shader block.
+    const size_t newShader = out.size();
+    const uint32_t blockWords = (virtualSize - shaderOffset) / 4;
+    auto block = [&](uint32_t i) { return i < blockWords ? rd(shaderOffset + 4 * i) : 0u; };
+    wr(0);             // physicalOffset: the microcode starts the physical part
+    wr(physicalSize);  // size
+    wr(block(0));      // field8
+    wr(block(1));      // fieldC
+    wr(block(2));      // field10
+    wr(block(4));      // interpolatorInfo
+    if (isPixelShader)
+    {
+        for (uint32_t i = 6; i < blockWords; i++)
+            wr(block(i));
+    }
+    else
+    {
+        wr(block(6));  // field18
+        wr(block(7));  // vertexElementCount
+        wr(block(8));  // field20
+        for (uint32_t i = 10; i < blockWords; i++)
+            wr(block(i));
+    }
+
+    // Physical part: the microcode, then the float4 literals.
+    const uint32_t newVirtualSize = uint32_t(out.size());
+    out.insert(out.end(), src + virtualSize, src + virtualSize + physicalSize);
+    for (uint32_t v : literals)
+        wr(v);
+
+    patch(0x00, (flags & 0xFFFF00FF) | 0x1100);
+    patch(0x04, newVirtualSize);
+    patch(0x08, uint32_t(out.size()) - newVirtualSize);
+    patch(0x0C, 0);
+    patch(0x10, uint32_t(newConstantTable));
+    patch(0x14, uint32_t(newDefinitionTable));
+    patch(0x18, uint32_t(newShader));
+    return out;
+}
